---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import { allParagraphs, groupLabel, statusLabel } from "../../lib/paragraphs";
import { diffWords } from "../../lib/diff";
import { crossRefs } from "../../lib/crossrefs";

export const getStaticPaths = (async () => {
  const all = await allParagraphs();
  return all.map((p, i) => ({
    params: { n: String(p.data.disciplineNumber) },
    props: { p, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}) satisfies GetStaticPaths;

const { p, prev, next } = Astro.props;
const d = p.data;

// A diff only helps where the paragraph was edited rather than replaced. On the
// rewritten ones almost every word is marked, which is noise dressed as detail.
const showDiff =
  d.status === "amended" && !d.rewritten && !d.elided && d.textOld && d.textNew;
const tokens = showDiff ? diffWords(d.textOld.trim(), d.textNew.trim()) : null;
const refs = crossRefs(d.textNew);
---

<Base
  title={`¶${d.disciplineNumber} — UMC regionalization`}
  description={d.summary ?? `The text of ¶${d.disciplineNumber} before and after the regionalization amendment.`}
>
  <div class="para-head">
    <p class="eyebrow">{groupLabel(p)}</p>
    <h1>¶{d.disciplineNumber}</h1>
    {d.summary && <p class="subtitle">{d.summary}</p>}

    <dl class="para-nums">
      <div>
        <dt>2024 Discipline</dt>
        <dd>¶{d.disciplineNumber}</dd>
      </div>
      <div>
        <dt>On the ballot paper</dt>
        <dd>¶{d.ballotNumber}</dd>
      </div>
      <div>
        <dt>Article</dt>
        <dd>
          {
            d.status === "deleted"
              ? d.articleOld
              : d.articleOld && d.articleOld !== d.articleNew
                ? `${d.articleOld} → ${d.articleNew}`
                : d.articleNew || d.articleOld
          }
        </dd>
      </div>
      <div>
        <dt>Change</dt>
        <dd>{statusLabel(p)}</dd>
      </div>
    </dl>
  </div>

  {
    d.notes.length > 0 && (
      <div class="notice">
        {d.notes.map((note) => (
          <p>{note}</p>
        ))}
      </div>
    )
  }

  {d.whatChanged && (
    <>
      <h2>What changed</h2>
      <p>{d.whatChanged}</p>
    </>
  )}

  <div class="texts">
    <section class="text-panel">
      <h2>Before</h2>
      <p class="src">Book of Discipline 2020/2024, ¶{d.disciplineNumber}</p>
      {
        d.textOld ? (
          // Kept on one line: the panel is `white-space: pre-wrap`, so template
          // indentation around the expression would render as leading blanks.
          <div class:list={["body", d.status === "deleted" && "struck"]}>{d.textOld.trim()}</div>
        ) : (
          <p class="empty">
            No prior text — this paragraph is added by the amendment.
          </p>
        )
      }
    </section>

    <section class="text-panel text-panel--new">
      <h2>After</h2>
      <p class="src">
        {
          d.status === "deleted"
            ? "Struck by the amendment"
            : `Petition 21039, as ratified${d.elided ? " (changed portions only)" : ""}`
        }
      </p>
      {
        d.textNew ? (
          <div class="body">{d.textNew.trim()}</div>
        ) : (
          <p class="empty">
            Nothing. The paragraph is struck and does not appear in the
            post-ratification text.
          </p>
        )
      }
    </section>
  </div>

  {
    refs.length > 0 && (
      <>
        <h2>Where it points</h2>
        <p>
          This paragraph cites {refs.length === 1 ? "another paragraph" : "other paragraphs"} of
          the Constitution — and cites {refs.length === 1 ? "it" : "them"} in <strong>ballot
          numbering</strong>, the numbering the amendment was drafted against. Following the
          citation as printed, into the 2024 Book of Discipline, lands on the wrong paragraph.
          The text is left exactly as ratified; the translation is below.
        </p>
        <table class="para-table">
          <thead>
            <tr>
              <th scope="col">As printed</th>
              <th scope="col">In the 2024 Discipline</th>
              <th scope="col">Which is</th>
            </tr>
          </thead>
          <tbody>
            {refs.map((r) => (
              <tr>
                <td class="num">¶{r.cited}</td>
                <td class="num">
                  <a href={`/p/${r.target}`}>¶{r.resolved}</a>
                </td>
                <td>
                  <p>{r.describes}</p>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  {
    tokens && (
      <>
        <h2>Word by word</h2>
        <p class="diff-key">
          Generated by comparing the two texts above. Added wording is marked, struck
          wording is ruled through.
        </p>
        <p class="diff-body">{tokens.map((t) => (t.type === "ins" ? <ins>{t.text}</ins> : t.type === "del" ? <del>{t.text}</del> : <span>{t.text}</span>))}</p>
      </>
    )
  }

  <nav class="pager">
    <span>{prev && <a href={`/p/${prev.data.disciplineNumber}`}>← ¶{prev.data.disciplineNumber}</a>}</span>
    <span><a href="/paragraphs">All paragraphs</a></span>
    <span>{next && <a href={`/p/${next.data.disciplineNumber}`}>¶{next.data.disciplineNumber} →</a>}</span>
  </nav>
</Base>
